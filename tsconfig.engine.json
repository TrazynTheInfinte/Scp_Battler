{
  // The battle engine must stay free of DOM/browser APIs (docs/adr/0001).
  // This project type-checks src/engine with no DOM lib, so any accidental
  // use of window/document/etc. fails `tsc -b`.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.engine.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": [],
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/engine"],
  "exclude": ["src/engine/**/*.test.ts"]
}
